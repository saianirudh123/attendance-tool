# Public URL of the deployed app, no trailing slash.
# Local: http://127.0.0.1:8000
# Hosted: https://your-attendance-app.example.com
APP_BASE_URL=http://127.0.0.1:8000

# Generate a long random value for production.
SESSION_SECRET=replace-with-a-long-random-secret

# Google OAuth client from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional comma-separated Google Workspace domains.
# Example: krishnaengineering.com
ALLOWED_GOOGLE_DOMAINS=krishna-engineering.com

# Comma-separated emails that should always be admin or maker.
# Built-in defaults:
#   Admin: saianirudh@krishna-engineering.com
#   Maker: accounts@krishna-engineering.com
ADMIN_EMAILS=saianirudh@krishna-engineering.com
MAKER_EMAILS=accounts@krishna-engineering.com
